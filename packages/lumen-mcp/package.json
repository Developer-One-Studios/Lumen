{
  "name": "lumen-mcp",
  "version": "1.1.0",
  "private": true,
  "description": "Lumen: an MCP server that gives AI agents full control of Roblox Studio, plus tools to test, profile and debug games",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lumen-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "studio-plugin/LumenPlugin.rbxmx"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/prepack.mjs",
    "postpack": "node ../../scripts/postpack.mjs"
  },
  "keywords": [
    "mcp",
    "roblox",
    "studio",
    "ai",
    "model-context-protocol",
    "game-development"
  ],
  "author": "Developer One Studios",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "lumen-mcp-core": "*"
  }
}
