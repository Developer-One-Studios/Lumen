{
  "name": "lumen-mcp-inspector",
  "version": "1.0.1",
  "private": true,
  "description": "Lumen Inspector: the read-only edition of Lumen for inspecting Roblox Studio",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lumen-mcp-inspector": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "studio-plugin/LumenInspectorPlugin.rbxmx"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/prepack.mjs",
    "postpack": "node ../../scripts/postpack.mjs"
  },
  "keywords": [
    "mcp",
    "roblox",
    "studio",
    "ai",
    "model-context-protocol",
    "game-development",
    "inspector",
    "read-only"
  ],
  "author": "Developer One Studios",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "lumen-mcp-core": "*"
  }
}
